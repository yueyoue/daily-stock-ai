# 复制为 .env 并填写：cp .env.example .env
# .env 不要提交到 git（加进 .gitignore）

# ---- 安全（T0.4 登录鉴权）----
SECRET_KEY=change-me-to-a-long-random-string   # 会话签名密钥，生产务必替换为随机强串
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-then-login-and-change   # 首次启动创建管理员；留空则随机生成并打印在容器日志
# 接口文档（Swagger/OpenAPI）开关：放行 /api/docs 与 /api/openapi.json（T8.5 安全自查）。
# 生产保持 false —— 免鉴权白名单仅剩 /api/health + /api/auth/login，不再对外暴露接口清单；
# 本地开发需要浏览接口时置 true（代码默认 true）。
API_DOCS_ENABLED=false

# ---- 数据库 ----
DB_ROOT_PASSWORD=change-me-root-strong
DB_PASSWORD=change-me-strong

# ---- LLM（密钥只放这里，不进数据库、不进前端）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus

# ---- 定时任务（可选覆盖；APScheduler 时区固定 Asia/Shanghai，不要改成别的）----
# 时间线（开发文档 §4.9）：每日 07:30 隔夜资讯 → 交易日 08:00 早报 →
#   交易日 15:30 收盘采集 → 交易日 16:00 指标缓存 → 交易日 17:00 盘后复盘
# 非交易日只跑资讯线（不生成报告）；SCHEDULER_ENABLED=false 可整体关闭进程内调度器
# SCHEDULER_ENABLED=true
# ⚠️ 星期段必须用 mon-fri（APScheduler 3.x 的 0=周一，数字 1-5 会被解读为周二~周六，周一不触发）
# REPORT_AM_CRON=0 8 * * mon-fri
# REPORT_PM_CRON=0 17 * * mon-fri
# REPORT_AM_ENABLED=true
# REPORT_PM_ENABLED=true
# COLLECT_AM_CRON=30 7 * * *
# COLLECT_PM_CRON=30 15 * * mon-fri
# COLLECT_AM_ENABLED=true
# COLLECT_PM_ENABLED=true

# ---- 失败告警（T7.6，开发文档 §1.4）----
# 留空：任务失败只写日志（ALERT）+ task_log 的 warning 行；
# 填 URL：任务重试 3 次仍失败后，向该地址 POST JSON（3 秒超时，best-effort，失败不影响任务）
# ALERT_WEBHOOK=https://example.com/hooks/dsa-alert
