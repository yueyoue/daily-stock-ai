# 复制为 .env 并填写：cp .env.example .env
# .env 不要提交到 git（加进 .gitignore）

# ---- 安全（T0.4 登录鉴权）----
SECRET_KEY=请替…机串
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change…n   # 首次启动创建管理员；留空则随机生成并打印在容器日志

# ---- 数据库 ----
DB_ROOT_PASSWORD=change-me-root-strong
DB_PASSWORD=change-me-strong

# ---- LLM（密钥只放这里，不进数据库、不进前端）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus

# ---- 定时任务（可选覆盖；APScheduler 时区固定 Asia/Shanghai）----
# REPORT_AM_CRON=0 8 * * 1-5
# REPORT_PM_CRON=0 17 * * 1-5
